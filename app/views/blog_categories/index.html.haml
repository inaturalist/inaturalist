- content_for(:title) do
  = t :blog_categories
- content_for :extracss do
  = stylesheet_link_tag "blog_categories"
.blog-categories
  = link_to t(:back), site_posts_path, class: "blog-categories-back"
  %h1= t :blog_categories
  = link_to t(:new_blog_category), new_blog_category_path, class: "blog-categories-button blog-categories-button-primary"
  - if @blog_categories.empty?
    %p.blog-categories-empty= t :no_blog_categories_yet
  - else
    .blog-categories-table-wrapper
      %table.blog-categories-table
        %thead
          %tr
            %th= BlogCategory.human_attribute_name( :position )
            %th= BlogCategory.human_attribute_name( :label )
            %th= t :url_slug
            %th= t :posts
            %th
        %tbody
          - @blog_categories.each do |blog_category|
            %tr
              %td= blog_category.position
              %td= blog_category.label
              %td
                %code= blog_category.slug
              %td= blog_category.posts_count
              %td
                .blog-categories-actions
                  = link_to edit_blog_category_path( id: blog_category.id ), class: "blog-categories-button" do
                    %i.fa.fa-pencil
                    = t :edit
                  = link_to blog_category_path( id: blog_category.id ), method: :delete, data: { confirm: t( :are_you_sure? ) }, class: "blog-categories-button blog-categories-button-danger" do
                    %i.fa.fa-trash
                    = t :delete
