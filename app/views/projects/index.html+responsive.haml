- content_for :title do
  = @title = t(:projects)
- content_for :extracss do
  = stylesheet_link_tag "projects/index_responsive"
- content_for :extrajs do
  = javascript_include_tag "webpack/carousel-webpack"

#hero-container
  - hero_projects = @carousel.presence || [@recent].flatten.compact[0..5]
  .hero
    - if hero_projects.many?
      .hero-feature.Carousel{ role: "region", "aria-roledescription": "carousel", "aria-label": t(:featured), data: { carousel_root: true, carousel_autoplay: 5000 } }
        .Carousel-controls
          %button.Carousel-rotation{ type: "button", data: { carousel_rotation: true, label_start: t(:start_slide_rotation), label_stop: t(:stop_slide_rotation) } }
            %span.Carousel-rotation-icon{ "aria-hidden": "true" }
            %span.sr-only{ data: { carousel_rotation_label: true } }=t :stop_slide_rotation
          .Carousel-dots
            - hero_projects.each_index do |i|
              %button.Carousel-dot{ type: "button", "aria-label": t(:slide_x, x: i + 1), "aria-current": i.zero?.to_s, data: { carousel_dot: i } }
        .Carousel-track{ "aria-live": "off", tabindex: -1, data: { carousel_track: true } }
          - hero_projects.each_with_index do |project, i|
            .Carousel-slide{ role: "group", "aria-roledescription": "slide", "aria-label": t(:x_of_y, x: i + 1, y: hero_projects.size), data: { carousel_slide: true } }
              = render "hero_slide", project: project, noteworthy: @noteworthy_ids.include?( project.id )
    - elsif hero_projects.one?
      .hero-feature
        = render "hero_slide", project: hero_projects.first, noteworthy: @noteworthy_ids.include?( hero_projects.first.id )
    #about-projects
      .about-projects-content
        %h1=t :projects
        %p=t :projects_description, site_name: @site.name
        = link_to t(:start_a_project), new_project_path, class: "btn btn-primary btn-inat"

#tools-container
  .tools-content
    = form_tag( project_search_path, method: :get, class: "project-search" ) do
      %input{ name: "q", type: "text", placeholder: t(:search) }
      %button.btn.btn-primary{ type: "submit" }=t :go
    - if logged_in? && !@started.blank? || !@joined.blank?
      %details.ProjectsMenu
        %summary
          %i.fa.fa-gear
          =t :manage_your_projects
        %ul
          - unless @started.blank?
            %li.menu-header=t :your_projects
            - @started.each do |project|
              %li= link_to project.title, project
          - unless @joined.blank?
            %li.menu-header=t :joined_projects
            - @joined.each do |project|
              %li= link_to project.title, project
          %li= link_to t(:view_all), projects_by_login_path( current_user.login )

#main-container
  .projects-content
    - unless @featured.blank?
      %h2=t :featured
      .ProjectCardGrid
        - @featured.each do |project|
          = render "thumbnail", project: project
    %h2=t :recently_active
    - if @recent.blank?
      .nocontent=t :no_projects_yet
    - else
      .ProjectCardGrid
        - @recent.each do |project|
          = render "thumbnail", project: project
    - unless @created.blank?
      %h2=t :recently_created
      .ProjectCardGrid
        - @created.each do |project|
          = render "thumbnail", project: project
      = link_to t(:browse_all_projects), browse_projects_path, class: "btn btn-primary btn-inat"
