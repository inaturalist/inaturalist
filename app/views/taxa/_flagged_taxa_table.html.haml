:ruby
  flagged_taxa = flagged_taxa_table[:flagged_taxa].to_a
  flagged_taxa_count = flagged_taxa_table[:flagged_taxa_count]
.flagged_taxa_table
  .flagged-taxa-scroll
    %table.table.table-bordered
      %thead
        %tr
          %th= t( :flagged_taxon )
          %th.text-center= t( :open_flags )
          %th
      %tbody
        - flagged_taxa.each do |flagged_taxon|
          %tr
            %td= link_to flagged_taxon.name, taxon_path( flagged_taxon )
            %td.text-center
              %span.badge= flagged_taxon.open_flags_count
            %td.text-right
              = link_to "#{t( :view_all_flags )} &rarr;".html_safe, flags_path( flaggable_type: "Taxon", taxon_id: flagged_taxon.id, resolved: "no" )
  .flagged-taxa-footer.text-muted
    - if flagged_taxa.length > 10
      %div= t( :x_open_flags_scroll_for_more, count: flagged_taxa_count )
    %div= t( :flagged_taxa_counts_explanation, open_flags: t( :open_flags ), view_all_flags: t( :view_all_flags ) )
