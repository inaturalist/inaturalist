- user = blog_comment.user
- hidden = blog_comment.hidden?
- visible = !hidden || blog_comment.hidden_content_viewable_by?( current_user )
- actions = comment_action_links( blog_comment )
%li.blog-comment{ id: "activity_comment_#{blog_comment.uuid}" }
  - if visible && user
    = image_tag user.icon.url( :thumb ), alt: "", class: "blog-comment__avatar"
  - else
    %span.blog-comment__avatar
  .blog-comment__main
    .blog-comment__meta
      - if visible && user
        = link_to user.login, person_path( user ), class: "blog-comment__who"
      %time{ datetime: blog_comment.created_at.iso8601 }
        = t( :n_ago, n: time_ago_in_words( blog_comment.created_at ) )
    - if visible
      .blog-comment__body
        = formatted_user_text( blog_comment.body, tags: Observation::ALLOWED_DESCRIPTION_TAGS )
    - if hidden
      %p.blog-comment__hidden= t( :content_hidden )
    - if actions.any?
      %p.blog-comment__actions= safe_join( actions, " · " )
