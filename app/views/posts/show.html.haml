- content_for :title do
  =title_by_user @title = @post.title
- content_for :extracss do
  = stylesheet_link_tag "posts/show"
- content_for :extrajs do
  :javascript
    $('.observationcontrols').observationControls({ div: $('#observations .observations') })
    $("#comment_body").textcompleteUsers( );
    $( ".emailConfirmationModalTrigger, #flag_this, a.flaglink" ).click( function( e ) {
      if ( $( "#emailConfirmationModalButton.lacking-interaction" ).length === 1 ) {
        $( "#emailConfirmationModalButton.lacking-interaction" ).click( );
        e.preventDefault( );
        e.stopPropagation( );
      }
    } );
- content_for :extrahead do
  %meta{:property => "og:image", :content => html_attributize(@shareable_image_url)}
  %meta{:property => "twitter:image", :content => html_attributize(@shareable_image_url)}
  %meta{:property => "og:description", :content => html_attributize(@shareable_description)}
  %meta{:name => "twitter:card", :content => "summary"}
  %meta{:name => "og:title", :content => html_attributize(@title)}
  %link{ rel: "schema.DC", href: "http://purl.org/dc/elements/1.1/" }
  %link{ rel: "schema.DCTERMS", href: "http://purl.org/dc/terms/" }
  %meta{ name: "DC.creator", content: @post.user.published_name }
  %meta{ name: "DC.publisher", content: @site.name }
  %meta{ name: "DCTERMS.issued", content: @post.published_at }
.post-page
  - if @post.published_at.nil?
    .alert.alert-warning.upstacked= t(:preview)
  %ul.breadcrumb.post-breadcrumb
    %li
      - if @post.parent.is_a?(Project)
        - if @post.parent.is_new_project?
          = link_to t( :x_project_journal, project: @post.parent.title, name: t( :journal ) ), project_journal_path(@post.parent)
        - else
          = link_to t(:x_journal, :user => @post.parent.title), project_journal_path(@post.parent)
      - elsif @post.parent.is_a?(Site)
        = link_to t(:x_blog, x: @post.parent.name), site_posts_path
      - elsif @post.is_a?(Trip)
        = link_to t(:trips), trips_path
      - else
        - link_txt = is_me? ? t(:header_your_journal) : t(:users_journal, user: @post.user.login, vow_or_con: @post.user.login[0].downcase )
        = link_to link_txt, journal_by_login_path( @post.user.login )
    %li.active
      = link_to @post.title, @post
      - if @post.is_a?(Trip)
        = surround '(', ')' do
          =t :trip
    %li.prevnext.post-prevnext
      - if @prev
        = link_to @prev do
          %i.fa.fa-chevron-left
          = truncate @prev.title
      - if @next
        = '|' if @prev
        = link_to @next do
          = truncate @next.title
          %i.fa.fa-chevron-right
  - nav_links = capture do
    - if @post.is_a?( Trip ) && !@target_list_set.blank?
      %li= link_to t( :target_list ), "#target_list"
    - unless @observations.blank?
      %li= link_to t(:observations), "#observations"
    - comments_count = @post.comments.size
    - if comments_count.positive?
      %li= link_to t( :x_comments, count: comments_count ), "#comments"
  .post-layout.upstacked
    - if nav_links.present?
      %nav.post-nav.post-nav-side
        %ul= nav_links
    .post-content
      %section{:id => "summary"}
        .post-title-row
          %h1= @title
          - if @post.editable_by?(current_user)
            = link_to @post.is_a?(Trip) ? edit_trip_path(@post) : edit_post_path(@post), :class => "btn btn-default" do
              %i.fa.fa-edit
              = t(:edit)
        - if nav_links.present?
          %nav.post-nav.post-nav-inline
            %ul= nav_links
        - if @post.is_a?(Trip)
          .subtitle.text-muted
            = l(@post.start_time, :format => :long) if @post.start_time
            \-
            = l(@post.stop_time, :format => :long) if @post.start_time
          .small.text-muted.stacked
            \|
            - if @post.latitude
              = t( :latitude_value, latitude: @post.latitude.round( 3 ) )  if @post.latitude
              \|
            - if @post.longitude
              = t( :longitude_value, longitude: @post.longitude.round( 3 ) )
              \|
            - if @post.radius
              = t( :radius_value, radius: @post.radius )
              \|
            - if @post.distance
              = t( :distance_traveled_value, distance: @post.distance.to_i )
              \|
            - if ( @post.start_time && @post.stop_time )
              = t( :duration_value, duration: ( ( @post.stop_time - @post.start_time ) / 1.minutes ).to_i )
              \|
            - if @post.number
              = t( :number_of_observers_value, number: @post.number )
              \|
      - unless @post.body.blank?
        %section.stacked.post{:id => "description"}
          = formatted_user_text(@post.body, scrubber: PostScrubber.new(tags: Post::ALLOWED_TAGS, attributes: Post::ALLOWED_ATTRIBUTES), skip_simple_format: (@post.preferred_formatting == Post::FORMATTING_NONE))
          .post-attribution.small.text-muted.stacked
            = render "posts/attribution", post: @post
      - if @post.is_a?(Trip)
        - unless @target_list_set.blank?
          %section{:id => "target_list"}
            %h2
              =t :target_list
              %span.glyphicon.glyphicon-info-sign.info-link{ "style" => "margin-left:5px;font-size:15px;color:gray", "data-content" => t(:trip_target_list_info), "data-placement" => "top", "data-toggle" => "popover" }
            %ul.taxon_links.plain.post-target-list
              - @target_list_set.each do |element|
                %li
                  = render "shared/taxon", :taxon => element[:taxon], :link_url => element[:taxon]
                  - if element[:observations].count > 0
                    - element[:observations][0..7].each do |o|
                      = link_to observation_path( :id => o["id"] )  do
                        %svg{ :height => "10", :width => "10" }
                          %title= o["taxon"]["name"]
                          %circle{ :cx => "5", :cy => "5", :r => "5", :stroke => "black", :stroke-width => "3", :fill => "#337ab7" }
                    - if element[:observations].count > 8
                      ="..."
      - unless @observations.blank?
        %section.post-observations{:id => "observations"}
          .observation-header
            %h2=t :observations
            .observationcontrols
          .observations.medium.grid
            - compact do
              = render :partial => "observations/cached_component", :collection => @observations
          - if @post.is_a?(Trip)
            .text-muted
              :ruby
                obs_params = {
                  taxon_is_active: true,
                  lat: @post.latitude,
                  lng: @post.longitude,
                  radius: @post.radius.to_f / 1000,
                  d1: @post.start_time.iso8601,
                  d2: @post.stop_time.iso8601,
                  user_id: @post.user_id
                }
                obs_params[:place_id] = @post.place_id unless @post.place_id.blank?
              = link_to observations_url(obs_params), :class => "readmore" do
                =t( :search_observations)
      %section{:id => "comments"}
        - if @post.published_at
          = render "comments/comments", parent: @post, header_tag: :h2, hide_form: @post.prefers_no_comments?
        - else
          = render "comments/comments", parent: @post, header_tag: :h2, hide_form: true
        - if logged_in? && current_user.id != @post.user_id && !@post.prefers_no_comments?
          .upstacked
            = render "subscriptions/subscription", resource: @post.becomes( Post )
        .upstacked
          = render :partial => "shared/flagging", :locals => { :instance => @post.becomes( Post ) }
  = render "shared/scroll_to_top"
