- content_for :title do
  =title_by_user @title = @post.title
- content_for :extracss do
  = stylesheet_link_tag "posts/blog"
- content_for :extrajs do
  :javascript
    var linkedComment = window.location.hash && document.getElementById( window.location.hash.slice( 1 ) );
    var linkedCommentList = linkedComment && linkedComment.closest( ".post-comments__details" );
    if ( linkedCommentList ) {
      linkedCommentList.open = true;
      linkedComment.scrollIntoView( );
    }
    $( "#comment_body" ).textcompleteUsers( );
    $( ".emailConfirmationModalTrigger, #flag_this, a.flaglink" ).click( function( e ) {
      if ( $( "#emailConfirmationModalButton.lacking-interaction" ).length === 1 ) {
        $( "#emailConfirmationModalButton.lacking-interaction" ).click( );
        e.preventDefault( );
        e.stopPropagation( );
      }
    } );
= render "posts/meta"
= render "posts/v2_post",
  post: @post,
  observations: @observations,
  back_label: t( "views.posts.show_blog.site_blog", site: @post.parent.name ),
  back_path: site_posts_path,
  eyebrow: @post.blog_category&.label,
  other_heading: t( "views.posts.show_blog.other_posts" ),
  other_posts: @other_posts
