= content_for :title do
  = @title = t(:leaderboard_for_x, :x => (@time_unit == 'month' ? l(@date, :format => :month_year) : @year))
= content_for :extracss do
  = stylesheet_link_tag 'users_responsive'
- cache @leaderboard_key, :expires_in => 1.day do
  #pageheader.leaderboard-header
    .breadcrumbs
      = link_to t(:back_to_people), people_path, :class => "crumb back"
      .updated
        =t :updated_daily
        = surround '(', ')' do
          %abbr.timeago{"data-now" => Time.now.getutc.iso8601, :title => Time.now.getutc.iso8601}=t :n_ago, :n => time_ago_in_words(Time.now)
    %h2
      = @title
  #leaderboard
    .CardGrid
      = render 'leaderboard_column',
        noun: 'observation',
        noun_plural: 'observations',
        time_unit: @time_unit,
        data: @most_observations
      = render 'leaderboard_column',
        noun: 'species',
        noun_plural: 'species',
        time_unit: @time_unit,
        data: @most_species
      = render 'leaderboard_column',
        noun: 'identification',
        noun_plural: 'identifications',
        time_unit: @time_unit,
        data: @most_identifications,
        sub: Proc.new {|user, count| link_to("#{t :x_identifications_html, count: count}".html_safe, identifications_by_login_path(user.login, :on => @time_unit == 'year' ? @year : "#{@year}-#{@month}"))}
    .leaderboard-note=raw t :observations_observed_this_month
.leaderboard-pager
  - if @time_unit == 'year'
    %strong= link_to "‹ #{@year - 1}".html_safe, :year => @year - 1
    - if @year < Date.today.year
      %strong= link_to "#{@year + 1} ›".html_safe, :year => @year + 1
  - else
    - prev_date = @date - 1.month
    - next_date = @date + 1.month
    %strong= link_to "‹ #{l prev_date, :format => :month_year}".html_safe, :year => prev_date.year, :month => prev_date.month
    - unless next_date > Date.today
      %strong= link_to "#{l next_date, :format => :month_year} ›".html_safe, :year => next_date.year, :month => next_date.month
